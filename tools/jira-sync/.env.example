# ============================================================
#  Jira Sync – Environment Variables  (SAMPLE)
#  Copy this file to .env and fill in your values.
# ============================================================

# Your Jira Cloud base URL — no trailing slash
# Example: https://yourcompany.atlassian.net
JIRA_BASE_URL=https://yourcompany.atlassian.net

# The email address linked to your Atlassian account
JIRA_EMAIL=your.email@company.com

# Jira API token
# Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# (Optional) Filter tickets to a specific Jira project key.
# Leave blank to fetch tickets across ALL projects.
# Example: API
JIRA_PROJECT_KEY=

# (Optional) Absolute or relative path where ticket folders will be written.
# Defaults to ./jira_tickets/ next to this script.
OUTPUT_DIR=

# GitHub repository for PR status lookups  (format: OrgOrUser/RepoName)
# The script uses the `gh` CLI — run `gh auth login` once if not authenticated.
# Example: EzyWebwerkstaden/VivaAerobus.Generic.Api
GITHUB_REPO=

# Set to "true" to automatically transition Jira tickets to UAT when their
# PR is merged, unassign them, and add the tracking label below.
# Default: false (read-only mode)
AUTO_TRANSITION_UAT=false

# Label added to every ticket you process so they stay filterable in Jira
# after being unassigned.  Leave blank to disable.
TRACKING_LABEL=
